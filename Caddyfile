{
    admin off
    auto_https off
    servers {
        protocols h1 h2c
    }
}

:8080 {
    handle /saeka-ssh* {
        reverse_proxy 127.0.0.1:2222 {
            # -1 disables Caddy's response buffering delay entirely - every
            # byte from the tunnel gets flushed to the client immediately
            # instead of waiting to fill a buffer first. This is the main
            # lever for killing added latency/ms-jumping at the proxy layer.
            flush_interval -1
        }
    }

    handle {
        respond "MASTER SUPOT Secure GCP Gateway Active." 200
    }
}
