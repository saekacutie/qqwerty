static_resources:
  listeners:
    - name: http_listener
      address:
        socket_address: { address: 0.0.0.0, port_value: 8080 }
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: xgcpx_http
                codec_type: AUTO
                stream_idle_timeout: 3600s
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                      log_format:
                        json_format: { method: "%REQ(:METHOD)%", path: "%REQ(X-ENVOY-ORIGINAL-PATH?:PATH)%", status: "%RESPONSE_CODE%", duration_ms: "%DURATION%" }
                upgrade_configs: [{ upgrade_type: websocket }]
                route_config:
                  name: xgcpx_routes
                  virtual_hosts:
                    - name: gateway
                      domains: ["*"]
                      response_headers_to_add:
                        - header: { key: X-Server-Status, value: "200" }
                      routes:
                        - match: { path: /healthz }
                          direct_response: { status: 200, body: { inline_string: '{"status":"ok"}' } }
                        - match: { prefix: /vless-grpc/ }
                          route: { cluster: protocol_upstream_h2, timeout: 3600s, host_rewrite_literal: "${PROTOCOL_HOST}" }
                        - match: { prefix: /vless-ws }
                          route: { cluster: protocol_upstream_h1, timeout: 3600s, host_rewrite_literal: "${PROTOCOL_HOST}" }
                        - match: { prefix: /vless-httpupgrade }
                          route: { cluster: protocol_upstream_h1, timeout: 3600s, host_rewrite_literal: "${PROTOCOL_HOST}" }
                        - match: { prefix: /xhttp- }
                          route: { cluster: protocol_upstream_h1, timeout: 3600s, host_rewrite_literal: "${PROTOCOL_HOST}" }
                        - match: { prefix: /trojan-ws }
                          route: { cluster: protocol_upstream_h1, timeout: 3600s, host_rewrite_literal: "${PROTOCOL_HOST}" }
                        - match: { prefix: /trojan-httpupgrade }
                          route: { cluster: protocol_upstream_h1, timeout: 3600s, host_rewrite_literal: "${PROTOCOL_HOST}" }
                        - match: { prefix: /vmess-ws }
                          route: { cluster: protocol_upstream_h1, timeout: 3600s, host_rewrite_literal: "${PROTOCOL_HOST}" }
                        - match: { prefix: /ssh-ws }
                          route: { cluster: protocol_upstream_h1, timeout: 3600s, host_rewrite_literal: "${PROTOCOL_HOST}" }
                        - match: { prefix: /assets/ }
                          response_headers_to_add:
                            - header: { key: Cache-Control, value: "public, max-age=300" }
                          route: { cluster: api_upstream, timeout: 3600s, host_rewrite_literal: "${PRIMARY_HOST}" }
                        - match: { prefix: /api/ }
                          route: { cluster: api_upstream, timeout: 3600s, host_rewrite_literal: "${PRIMARY_HOST}" }
                        - match: { prefix: / }
                          route: { cluster: api_upstream, timeout: 3600s, host_rewrite_literal: "${PRIMARY_HOST}" }
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

    - name: tcp_listener
      address:
        socket_address: { address: 0.0.0.0, port_value: 9000 }
      filter_chains:
        - filters:
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: xgcpx_tcp
                idle_timeout: 86400s
                cluster: tcp_upstream

    - name: tls_passthrough_listener
      address:
        socket_address: { address: 0.0.0.0, port_value: 9443 }
      listener_filters:
        - name: envoy.filters.listener.tls_inspector
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
      filter_chains:
        - filter_chain_match: { transport_protocol: tls }
          filters:
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: xgcpx_tls_passthrough
                idle_timeout: 86400s
                cluster: tls_upstream

  clusters:
    # Primary (priority 0) with fallback (priority 1). Both share one transport socket,
    # which is why the entrypoint requires the same host for https.
    # auto_config picks HTTP/1.1 for http:// and negotiates via ALPN for https://,
    # so plain HTTP backends are not forced into HTTP/2.
    - name: api_upstream
      type: STRICT_DNS
      connect_timeout: 5s
      lb_policy: ROUND_ROBIN
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          auto_config: {}
      load_assignment:
        cluster_name: api_upstream
        endpoints:
          - priority: 0
            lb_endpoints:
              - endpoint: { address: { socket_address: { address: "${PRIMARY_HOST}", port_value: ${PRIMARY_PORT} } } }
          - priority: 1
            lb_endpoints:
              - endpoint: { address: { socket_address: { address: "${FALLBACK_HOST}", port_value: ${FALLBACK_PORT} } } }
      ${UPSTREAM_TRANSPORT_SOCKET}

    - name: tcp_upstream
      type: STRICT_DNS
      connect_timeout: 5s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: tcp_upstream
        endpoints:
          - lb_endpoints:
              - endpoint: { address: { socket_address: { address: "${TCP_HOST}", port_value: ${TCP_PORT} } } }

    - name: tls_upstream
      type: STRICT_DNS
      connect_timeout: 5s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: tls_upstream
        endpoints:
          - lb_endpoints:
              - endpoint: { address: { socket_address: { address: "${TLS_HOST}", port_value: ${TLS_PORT} } } }

    # HTTP/1.1 for WebSocket and upgrade routes.
    - name: protocol_upstream_h1
      type: STRICT_DNS
      connect_timeout: 5s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: protocol_upstream_h1
        endpoints:
          - lb_endpoints:
              - endpoint: { address: { socket_address: { address: "${PROTOCOL_HOST}", port_value: ${PROTOCOL_PORT} } } }
      ${PROTOCOL_H1_TRANSPORT_SOCKET}

    # HTTP/2 for gRPC routes. Over TLS, ALPN is set to h2.
    - name: protocol_upstream_h2
      type: STRICT_DNS
      connect_timeout: 5s
      lb_policy: ROUND_ROBIN
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          explicit_http_config:
            http2_protocol_options: {}
      load_assignment:
        cluster_name: protocol_upstream_h2
        endpoints:
          - lb_endpoints:
              - endpoint: { address: { socket_address: { address: "${PROTOCOL_HOST}", port_value: ${PROTOCOL_PORT} } } }
      ${PROTOCOL_H2_TRANSPORT_SOCKET}
