{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "vless-ws",
      "listen": "127.0.0.1",
      "port": 10001,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "__VLESS_UUID__" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": { "path": "/vless-ws" }
      }
    },
    {
      "tag": "vless-httpupgrade",
      "listen": "127.0.0.1",
      "port": 10002,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "__VLESS_UUID__" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "httpupgrade",
        "httpupgradeSettings": { "path": "/vless-httpupgrade" }
      }
    },
    {
      "tag": "vless-grpc",
      "listen": "127.0.0.1",
      "port": 10003,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "__VLESS_UUID__" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "grpc",
        "grpcSettings": { "serviceName": "vless-grpc" }
      }
    },
    {
      "tag": "xhttp-packet",
      "listen": "127.0.0.1",
      "port": 10004,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "__VLESS_UUID__" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": { "path": "/xhttp-packet", "mode": "packet-up" }
      }
    },
    {
      "tag": "xhttp-chunked",
      "listen": "127.0.0.1",
      "port": 10005,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "__VLESS_UUID__" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": { "path": "/xhttp-chunked", "mode": "stream-up" }
      }
    },
    {
      "tag": "xhttp-request-response",
      "listen": "127.0.0.1",
      "port": 10006,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "__VLESS_UUID__" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": { "path": "/xhttp-request-response", "mode": "stream-one" }
      }
    },
    {
      "tag": "shadowsocks",
      "listen": "0.0.0.0",
      "port": 8388,
      "protocol": "shadowsocks",
      "settings": {
        "method": "chacha20-ietf-poly1305",
        "password": "__SHADOWSOCKS_PASSWORD__",
        "network": "tcp,udp"
      }
    },
    {
      "tag": "trojan-ws",
      "listen": "127.0.0.1",
      "port": 10007,
      "protocol": "trojan",
      "settings": {
        "clients": [{ "password": "__TROJAN_PASSWORD__" }]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": { "path": "/trojan-ws" }
      }
    },
    {
      "tag": "trojan-httpupgrade",
      "listen": "127.0.0.1",
      "port": 10010,
      "protocol": "trojan",
      "settings": {
        "clients": [{ "password": "__TROJAN_PASSWORD__" }]
      },
      "streamSettings": {
        "network": "httpupgrade",
        "httpupgradeSettings": { "path": "/trojan-httpupgrade" }
      }
    },
    {
      "tag": "vmess-ws",
      "listen": "127.0.0.1",
      "port": 10008,
      "protocol": "vmess",
      "settings": {
        "clients": [{ "id": "__VMESS_UUID__", "alterId": 0, "security": "auto" }]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": { "path": "/vmess-ws" }
      }
    },
    {
      "tag": "ssh-ws",
      "listen": "127.0.0.1",
      "port": 10009,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1",
        "port": 22,
        "network": "tcp"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": { "path": "/ssh-ws" }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
