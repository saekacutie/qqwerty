{
	admin off
	auto_https off
	servers {
		protocols h1 h2 h2c
	}
}

(app_upstream) {
	reverse_proxy {$UPSTREAM_PRIMARY} {$UPSTREAM_FALLBACK} {
		lb_policy first
		lb_try_duration 3s
		lb_retry_match {
			method GET HEAD
		}
		header_up Host {http.reverse_proxy.upstream.hostport}
		flush_interval -1
		transport http {
			versions 1.1
		}
	}
}

# Serves plain HTTP. The load balancer terminates public TLS/HTTP3 in front of this.
:8080 {
	log {
		output stdout
		format json
	}

	header X-Server-Status "200"
	header X-Content-Type-Options "nosniff"

	@health path /healthz
	handle @health {
		header Cache-Control "no-store"
		header Content-Type "application/json"
		respond `{"status":"ok"}` 200
	}

	# gRPC: HTTP/2 to the protocol upstream (h2c for http://, h2 over TLS for https://).
	@grpc {
		path /vless-grpc/*
	}
	handle @grpc {
		reverse_proxy {$PROTOCOL_UPSTREAM} {
			header_up Host {http.reverse_proxy.upstream.hostport}
			flush_interval -1
			transport http {
				versions 2 h2c
			}
		}
	}

	# WebSocket and HTTP upgrade routes: HTTP/1.1 only.
	@protocol_http path /vless-ws* /vless-httpupgrade* /xhttp-* /trojan-ws* /trojan-httpupgrade* /vmess-ws* /ssh-ws*
	handle @protocol_http {
		reverse_proxy {$PROTOCOL_UPSTREAM} {
			header_up Host {http.reverse_proxy.upstream.hostport}
			flush_interval -1
			transport http {
				versions 1.1
			}
		}
	}

	@api path /api/*
	handle @api {
		import app_upstream
	}

	@persistent path /persistent/*
	handle @persistent {
		import app_upstream
	}

	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=300, stale-while-revalidate=30"
		import app_upstream
	}

	handle {
		header Cache-Control "no-store"
		import app_upstream
	}
}
