{
	admin off
	auto_https off
	servers {
		protocols h1 h2 h2c
	}
}

(app_upstream) {
	reverse_proxy {$UPSTREAM_PRIMARY} {$UPSTREAM_FALLBACK} {
		lb_policy first
		lb_try_duration 3s
		lb_retry_match {
			method GET HEAD
		}
		flush_interval -1
		transport http {
			versions 1.1 2 h2c
		}
	}
}

# The load balancer terminates public TLS/HTTP3; this listener serves HTTP/1.1 and HTTP/2 upstream.
:8080 {
	log {
		output stdout
		format json
	}
	header X-Server-Status "200"
	header X-Content-Type-Options "nosniff"
	@health path /healthz
	handle @health {
		header Cache-Control "no-store"
		respond `{"status":"ok"}` 200
	}
	@protocol_grpc path /vless-grpc/*
	handle @protocol_grpc {
		reverse_proxy {$PROTOCOL_UPSTREAM} {
			header_up Host {$PROTOCOL_UPSTREAM_HOST}
			flush_interval -1
			transport http {
				versions 2 h2c
			}
		}
	}
	@protocol_http path /vless-ws /vless-httpupgrade /xhttp-* /trojan-ws /trojan-httpupgrade /vmess-ws /ssh-ws
	handle @protocol_http {
		reverse_proxy {$PROTOCOL_UPSTREAM} {
			header_up Host {$PROTOCOL_UPSTREAM_HOST}
			flush_interval -1
		}
	}
	# reverse_proxy handles WebSocket upgrades; immediate flushing supports streaming responses.
	@api path /api/*
	handle @api {
		import app_upstream
	}
	@grpc header Content-Type application/grpc*
	handle @grpc {
		import app_upstream
	}
	@persistent path /persistent/*
	handle @persistent {
		import app_upstream
	}
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=300, stale-while-revalidate=30"
		import app_upstream
	}
	handle {
		header Cache-Control "no-store"
		import app_upstream
	}
}
