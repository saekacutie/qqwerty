
http:
  serversTransports:
    gateway-transport:
      forwardingTimeouts:
        dialTimeout: 10s
        responseHeaderTimeout: 0s
        idleConnTimeout: 90s
      maxIdleConnsPerHost: 100

  middlewares:
    gateway-headers:
      headers:
        customResponseHeaders:
          X-Server-Status: "200"
          X-Content-Type-Options: "nosniff"

    asset-cache:
      headers:
        customResponseHeaders:
          Cache-Control: "public, max-age=300, stale-while-revalidate=30"

  routers:
    health:
      rule: "Path(`/healthz`)"
      service: ping@internal
      middlewares:
        - gateway-headers

    protocol-grpc:
      rule: "PathPrefix(`/vless-grpc/`)"
      priority: 1000
      service: protocol-grpc-pool
      middlewares:
        - gateway-headers

    grpc:
      rule: "HeaderRegexp(`Content-Type`, `^application/grpc`)"
      priority: 100
      service: grpc-pool
      middlewares:
        - gateway-headers

    protocol-http:
      rule: "Path(`/vless-ws`) || Path(`/vless-httpupgrade`) || PathPrefix(`/xhttp-`) || PathPrefix(`/trojan-ws`) || PathPrefix(`/trojan-httpupgrade`) || PathPrefix(`/vmess-ws`) || PathPrefix(`/ssh-ws`)"
      priority: 1000
      service: protocol-pool
      middlewares:
        - gateway-headers

    assets:
      rule: "PathPrefix(`/assets/`)"
      priority: 20
      service: api-pool
      middlewares:
        - gateway-headers
        - asset-cache

    api:
      rule: "PathPrefix(`/api/`)"
      priority: 10
      service: api-pool
      middlewares:
        - gateway-headers

    fallback:
      rule: "PathPrefix(`/`)"
      priority: 1
      service: api-pool
      middlewares:
        - gateway-headers

  services:
    api-pool:
      loadBalancer:
        serversTransport: gateway-transport
        passHostHeader: true
        servers:
          - url: "${UPSTREAM_PRIMARY}"
          - url: "${UPSTREAM_FALLBACK}"

    grpc-pool:
      loadBalancer:
        serversTransport: gateway-transport
        passHostHeader: true
        servers:
          - url: "${UPSTREAM_GRPC_PRIMARY}"
          - url: "${UPSTREAM_GRPC_FALLBACK}"

    protocol-pool:
      loadBalancer:
        serversTransport: gateway-transport
        passHostHeader: true
        servers:
          - url: "${PROTOCOL_UPSTREAM}"

    protocol-grpc-pool:
      loadBalancer:
        serversTransport: gateway-transport
        passHostHeader: true
        servers:
          - url: "${PROTOCOL_GRPC_UPSTREAM}"
