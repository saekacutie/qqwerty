http:
  middlewares:
    gateway-headers:
      headers:
        customResponseHeaders:
          X-Server-Status: "200"
          X-Content-Type-Options: "nosniff"
    asset-cache:
      headers:
        customResponseHeaders:
          Cache-Control: "public, max-age=300, stale-while-revalidate=30"
  routers:
    health:
      rule: Path(`/healthz`)
      service: ping@internal
      middlewares: [gateway-headers]
    grpc:
      # Match standard gRPC requests regardless of their /package.Service/Method path.
      rule: HeaderRegexp(`Content-Type`, `^application/grpc`)
      priority: 100
      service: grpc-pool
      middlewares: [gateway-headers]
    protocol-grpc:
      rule: PathPrefix(`/vless-grpc/`)
      priority: 1000
      service: protocol-grpc-pool
      middlewares: [gateway-headers]
    protocol-http:
      rule: Path(`/vless-ws`) || Path(`/vless-httpupgrade`) || PathPrefix(`/xhttp-`) || Path(`/trojan-ws`) || Path(`/trojan-httpupgrade`) || Path(`/vmess-ws`) || Path(`/ssh-ws`)
      priority: 1000
      service: protocol-pool
      middlewares: [gateway-headers]
    api:
      rule: PathPrefix(`/api/`)
      service: api-pool
      middlewares: [gateway-headers]
    assets:
      rule: PathPrefix(`/assets/`)
      service: api-pool
      middlewares: [gateway-headers, asset-cache]
    fallback:
      rule: PathPrefix(`/`)
      service: api-pool
      middlewares: [gateway-headers]
  services:
    api-pool:
      loadBalancer:
        servers:
          - url: "${UPSTREAM_PRIMARY}"
          - url: "${UPSTREAM_FALLBACK}"
        passHostHeader: false
    grpc-pool:
      loadBalancer:
        servers:
          - url: "${UPSTREAM_GRPC_PRIMARY}"
          - url: "${UPSTREAM_GRPC_FALLBACK}"
        passHostHeader: false
    protocol-pool:
      loadBalancer:
        servers:
          - url: "${PROTOCOL_UPSTREAM}"
        passHostHeader: false
    protocol-grpc-pool:
      loadBalancer:
        servers:
          - url: "${PROTOCOL_GRPC_UPSTREAM}"
        passHostHeader: false