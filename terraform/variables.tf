variable "project_id" {
  description = "GCP project ID."
  type        = string
}

variable "region" {
  description = "Region for Cloud Run, Artifact Registry, and the VM managed group."
  type        = string
}

variable "service_name" {
  description = "Cloud Run service and gateway resource prefix."
  type        = string
  default     = "api-gateway-404"

  validation {
    condition     = can(regex("^[a-z]([-a-z0-9]{0,47}[a-z0-9])?$", var.service_name))
    error_message = "service_name must be a valid lowercase Cloud Run service name."
  }
}

variable "image" {
  description = "Immutable or tagged container image URI in Artifact Registry."
  type        = string
}

variable "backend_image" {
  description = "Built-in Cloud Run API backend image used when no external HTTPS upstream is configured."
  type        = string
}

variable "enable_protocol_gateway" {
  description = "Create a public, authenticated protocol VM with a dedicated static IP."
  type        = bool
  default     = false
}

variable "protocol_image" {
  description = "Caddy and Xray image for the dedicated protocol VM."
  type        = string
  default     = ""
}

variable "protocol_domain" {
  description = "DNS hostname pointed at the dedicated protocol VM IP."
  type        = string
  default     = ""

  validation {
    condition     = var.protocol_domain == "" || can(regex("^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,}$", var.protocol_domain))
    error_message = "protocol_domain must be a fully qualified DNS hostname."
  }
}

variable "protocol_secret_name" {
  description = "Secret Manager secret containing the generated Xray configuration."
  type        = string
  default     = ""

  validation {
    condition     = var.protocol_secret_name == "" || can(regex("^[A-Za-z0-9_-]+$", var.protocol_secret_name))
    error_message = "protocol_secret_name must contain only letters, digits, underscores, and hyphens."
  }
}

variable "protocol_secret_version" {
  description = "Secret Manager version used to trigger a protocol VM restart on credential rotation."
  type        = string
  default     = ""
}

variable "protocol_image_revision" {
  description = "Unique protocol image tag used to restart the VM when its image changes."
  type        = string
  default     = ""
}

variable "protocol_startup_script" {
  description = "Rendered VM bootstrap script generated by deploy.sh."
  type        = string
  default     = ""
}

variable "protocol_tcp_ports" {
  description = "Public TCP ports enabled on the protocol VM."
  type        = list(string)
  default     = ["80", "443"]

  validation {
    condition     = alltrue([for port in var.protocol_tcp_ports : contains(["80", "443", "8080", "50051", "8388"], port)])
    error_message = "protocol_tcp_ports may contain only 80, 443, 8080, 50051, and 8388."
  }
}

variable "protocol_udp_ports" {
  description = "Public UDP ports enabled on the protocol VM."
  type        = list(string)
  default     = []

  validation {
    condition     = alltrue([for port in var.protocol_udp_ports : contains(["8388", "1194"], port)])
    error_message = "protocol_udp_ports may contain only 8388 and 1194."
  }
}

variable "enable_openvpn" {
  description = "Run a certificate-authenticated OpenVPN UDP service on the protocol VM."
  type        = bool
  default     = false
}

variable "openvpn_image" {
  description = "OpenVPN container image deployed alongside the protocol VM services."
  type        = string
  default     = ""
}

variable "openvpn_secret_name" {
  description = "Secret Manager secret containing OpenVPN server certificates and the tls-crypt key."
  type        = string
  default     = ""

  validation {
    condition     = var.openvpn_secret_name == "" || can(regex("^[A-Za-z0-9_-]+$", var.openvpn_secret_name))
    error_message = "openvpn_secret_name must contain only letters, digits, underscores, and hyphens."
  }
}

variable "openvpn_secret_version" {
  description = "Secret Manager version used to trigger protocol VM replacement on OpenVPN credential rotation."
  type        = string
  default     = ""
}

variable "machine_type" {
  description = "Compute Engine machine family selected for the persistent tier."
  type        = string
  default     = "e2-small"

  validation {
    condition     = contains(["e2-micro", "e2-small", "e2-medium", "c2-standard-4", "c2d-highcpu-8"], var.machine_type)
    error_message = "machine_type must be one of the xgcpx setup menu tiers."
  }
}

variable "domain" {
  description = "DNS hostname for the external HTTPS load balancer's Google-managed certificate."
  type        = string

  validation {
    condition     = can(regex("^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,}$", var.domain))
    error_message = "domain must be a fully qualified DNS hostname."
  }
}

variable "upstream_primary" {
  description = "Primary HTTP(S) application upstream URL. The built-in Cloud Run API sidecar is the local HTTP default."
  type        = string
  default     = "http://127.0.0.1:8081"

  validation {
    condition     = var.upstream_primary == "http://127.0.0.1:8081" || can(regex("^https://[^[:space:]\"\\\\]+$", var.upstream_primary))
    error_message = "upstream_primary must be HTTPS or the built-in http://127.0.0.1:8081 backend."
  }
}

variable "upstream_fallback" {
  description = "Fallback HTTP(S) application upstream URL. The built-in Cloud Run API sidecar is the local HTTP default."
  type        = string
  default     = "http://127.0.0.1:8081"

  validation {
    condition     = var.upstream_fallback == "http://127.0.0.1:8081" || can(regex("^https://[^[:space:]\"\\\\]+$", var.upstream_fallback))
    error_message = "upstream_fallback must be HTTPS or the built-in http://127.0.0.1:8081 backend."
  }
}

variable "blocked_cidrs" {
  description = "Optional CIDR blocks to deny at Cloud Armor."
  type        = list(string)
  default     = []

  validation {
    condition     = alltrue([for cidr in var.blocked_cidrs : can(cidrhost(cidr, 0))])
    error_message = "Every blocked_cidrs item must be a valid CIDR."
  }
}

variable "allowed_cidrs" {
  description = "Optional source allowlist. When non-empty, all other client IPs are denied."
  type        = list(string)
  default     = []

  validation {
    condition     = alltrue([for cidr in var.allowed_cidrs : can(cidrhost(cidr, 0))])
    error_message = "Every allowed_cidrs item must be a valid CIDR."
  }
}

variable "tcp_source_ranges" {
  description = "Optional CIDRs allowed to reach Envoy raw TCP/TLS listeners on VM ports 9000 and 9443."
  type        = list(string)
  default     = []

  validation {
    condition     = alltrue([for cidr in var.tcp_source_ranges : can(cidrhost(cidr, 0))])
    error_message = "Every tcp_source_ranges item must be a valid CIDR."
  }
}

variable "enable_tcp_proxy" {
  description = "Create regional TCP/TLS load balancers for the Envoy VM listeners."
  type        = bool
  default     = false
}

variable "tcp_upstream_host" {
  description = "Envoy raw TCP upstream host:port."
  type        = string
  default     = "tcp.example.com:9000"

  validation {
    condition     = can(regex("^[A-Za-z0-9.-]+:[0-9]{1,5}$", var.tcp_upstream_host))
    error_message = "tcp_upstream_host must be a DNS name or IPv4 address with a port."
  }
}

variable "tls_upstream_host" {
  description = "Envoy TLS passthrough upstream host:port."
  type        = string
  default     = "tls.example.com:9443"

  validation {
    condition     = can(regex("^[A-Za-z0-9.-]+:[0-9]{1,5}$", var.tls_upstream_host))
    error_message = "tls_upstream_host must be a DNS name or IPv4 address with a port."
  }
}

variable "requests_per_minute" {
  description = "Cloud Armor per-client request threshold before temporary banning."
  type        = number
  default     = 600

  validation {
    condition     = var.requests_per_minute >= 1 && var.requests_per_minute <= 100000 && floor(var.requests_per_minute) == var.requests_per_minute
    error_message = "requests_per_minute must be an integer between 1 and 100000."
  }
}